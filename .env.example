# Google Cloud OAuth client (type: Web application). See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the app is reachable. The redirect URI must match one registered in Google Cloud exactly.
BASE_URL=http://localhost:3000
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Encrypts the stored Google refresh tokens (falls back to SESSION_SECRET if empty)
TOKEN_KEY=

PORT=3000

# Shown on the /privacy and /terms pages so people know who to contact
CONTACT_EMAIL=

# Free-host persistence: create the `kv` table from README.md, then set both. Leave empty to use data/kv.json locally.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# DATA_DIR=./data
